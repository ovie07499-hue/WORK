# Required for real rewriting. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Model and effort per stage (low | medium | high | xhigh | max).
REFINER_MODEL=claude-opus-5-5
REFINER_PASS1_EFFORT=medium
REFINER_PASS2_EFFORT=low

# Retry declined requests server-side on Anthropic's recommended fallback model.
REFINER_ENABLE_FALLBACKS=true

# Set to true to run without an API key using a deterministic offline rewriter.
REFINER_MOCK_LLM=false

# Limits and tuning.
REFINER_MAX_WORDS=10000
REFINER_MAX_CHUNK_WORDS=320
REFINER_CHUNK_CONCURRENCY=4
REFINER_MAX_ACTIVE_JOBS=8
REFINER_JOB_TTL_SECONDS=1800

# JSON list of allowed browser origins (only needed when the UI is served from another origin).
REFINER_CORS_ORIGINS=["http://localhost:5173"]
